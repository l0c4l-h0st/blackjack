{
  "name": "nocturne-21",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nocturne 21 — blackjack solo en navigateur, crédits fictifs sans valeur.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "simulate": "tsx scripts/simulate.ts",
    "build:artifact": "tsc -b && VITE_BASE=./ VITE_ROUTER=memory vite build --outDir dist-artifact"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "dexie": "4.4.7",
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "zustand": "5.0.8",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "fake-indexeddb": "6.2.8",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.33",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
